# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# private uploaded documents
/storage/uploads/*
!/storage/uploads/.gitkeep

# legacy uploaded documents
/public/uploads/*
!/public/uploads/.gitkeep

# private uploaded documents
/storage/uploads/*
!/storage/uploads/.gitkeep

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files / secrets
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated prisma
/lib/generated/prisma

# local database backups
prisma/dev-backup-before-memory.db

# local development database
/prisma/dev.db
/prisma/dev.db-journal
/prisma/dev.db-shm
/prisma/dev.db-wal
.vercel
.env*
